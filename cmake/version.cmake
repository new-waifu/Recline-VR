# Writes the version header (cmake -P, run on every build). The version comes
# from git, so it is never maintained by hand:
#   v1.1.0              built from the commit tagged v1.1.0
#   v1.1.0+3.14d0169    3 commits after v1.1.0, at commit 14d0169
#   ...-dirty           with uncommitted changes
# Inputs: SRC (source dir), OUT (header path), OVERRIDE (RECLINE_VERSION, wins).

set(version "")
if(OVERRIDE)
  set(version "${OVERRIDE}")
else()
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" describe --tags --match "v[0-9]*" --dirty --always
                    OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
                    RESULT_VARIABLE rc)
    if(rc EQUAL 0)
      set(version "${describe}")
    endif()
  endif()
  if(version STREQUAL "")
    # A `git archive` (or a GitHub download) has no .git, but git fills in this
    # file through export-subst (.gitattributes).
    file(READ "${SRC}/cmake/version_archive.txt" archived)
    string(STRIP "${archived}" archived)
    if(NOT archived MATCHES "^\\$Format")
      set(version "${archived}")
    endif()
  endif()
  # v1.1.0-3-g14d0169[-dirty] -> v1.1.0+3.14d0169[-dirty]
  if(version MATCHES "^(.+)-([0-9]+)-g([0-9a-f]+)(-dirty)?$")
    set(version "${CMAKE_MATCH_1}+${CMAKE_MATCH_2}.${CMAKE_MATCH_3}${CMAKE_MATCH_4}")
  # No tag in reach (e.g. a shallow clone): just the commit.
  elseif(version MATCHES "^[0-9a-f]+(-dirty)?$")
    set(version "unknown+${version}")
  elseif(version STREQUAL "")
    set(version "unknown")
  endif()
endif()

set(content "// Generated by cmake/version.cmake; do not edit.\n#pragma once\n#define RECLINE_VERSION \"${version}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)  # unchanged: keep the timestamp, rebuild nothing
  file(WRITE "${OUT}" "${content}")
endif()
