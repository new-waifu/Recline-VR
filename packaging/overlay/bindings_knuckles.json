{
	"controller_type": "knuckles",
	"description": "Recline VR defaults: right trigger + grip + A + B to recenter, same on the left hand to reset, right trigger + grip + thumbstick click to show the panel; in the panel's gamepad mode, stick to move and right A to press",
	"name": "Recline VR defaults",
	"bindings": {
		"/actions/recline": {
			"sources": [
				{
					"path": "/user/hand/right/input/grip",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/trigger",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/a",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/b",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/left/input/grip",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/left/input/trigger",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/left/input/a",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/left/input/b",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/thumbstick",
					"mode": "joystick",
					"inputs": {},
					"parameters": {}
				}
			],
			"chords": [
				{
					"output": "/actions/recline/in/recenter",
					"inputs": [
						[ "/user/hand/right/input/grip", "click" ],
						[ "/user/hand/right/input/trigger", "click" ],
						[ "/user/hand/right/input/a", "single" ],
						[ "/user/hand/right/input/b", "single" ]
					]
				},
				{
					"output": "/actions/recline/in/reset",
					"inputs": [
						[ "/user/hand/left/input/grip", "click" ],
						[ "/user/hand/left/input/trigger", "click" ],
						[ "/user/hand/left/input/a", "single" ],
						[ "/user/hand/left/input/b", "single" ]
					]
				},
				{
					"output": "/actions/recline/in/show_panel",
					"inputs": [
						[ "/user/hand/right/input/grip", "click" ],
						[ "/user/hand/right/input/trigger", "click" ],
						[ "/user/hand/right/input/thumbstick", "click" ]
					]
				}
			],
			"haptics": [
				{
					"output": "/actions/recline/out/haptic",
					"path": "/user/hand/left/output/haptic"
				},
				{
					"output": "/actions/recline/out/haptic",
					"path": "/user/hand/right/output/haptic"
				}
			],
			"poses": [],
			"skeleton": []
		}
	}
}
