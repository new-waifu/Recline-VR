{
	"source" : "builtin",
	"applications" : [
		{
			"app_key" : "user.recline.overlay",
			"launch_type" : "binary",
			"@VR_BINARY_PATH_KEY@" : "recline_overlay",
			"is_dashboard_overlay" : true,
			"image_path" : "icon.png",
