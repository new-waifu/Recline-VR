{
	"controller_type": "frame_controller",
	"description": "Recline VR defaults: right grip + trigger + bumper + Y to recenter, + X to reset",
	"name": "Recline VR defaults",
	"bindings": {
		"/actions/recline": {
			"sources": [
				{
					"path": "/user/hand/right/input/grip",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/trigger",
					"mode": "trigger",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/bumper",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/y",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				},
				{
					"path": "/user/hand/right/input/x",
					"mode": "button",
					"inputs": {},
					"parameters": {}
				}
			],
			"chords": [
				{
					"output": "/actions/recline/in/recenter",
					"inputs": [
						[ "/user/hand/right/input/grip", "click" ],
						[ "/user/hand/right/input/trigger", "click" ],
						[ "/user/hand/right/input/bumper", "single" ],
						[ "/user/hand/right/input/y", "single" ]
					]
				},
				{
					"output": "/actions/recline/in/reset",
					"inputs": [
						[ "/user/hand/right/input/grip", "click" ],
						[ "/user/hand/right/input/trigger", "click" ],
						[ "/user/hand/right/input/bumper", "single" ],
						[ "/user/hand/right/input/x", "single" ]
					]
				}
			],
			"haptics": [
				{
					"output": "/actions/recline/out/haptic",
					"path": "/user/hand/left/output/haptic"
				},
				{
					"output": "/actions/recline/out/haptic",
					"path": "/user/hand/right/output/haptic"
				}
			],
			"poses": [],
			"skeleton": []
		}
	}
}
