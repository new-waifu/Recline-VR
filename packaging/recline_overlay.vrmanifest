{
	"source" : "builtin",
	"applications" : [
		{
			"app_key" : "user.recline.overlay",
			"launch_type" : "binary",
			"binary_path_linux_arm" : "bin/linuxarm64/recline_overlay",
			"binary_path_linux" : "bin/linux64/recline_overlay",
			"binary_path_windows" : "bin\\win64\\recline_overlay.exe",
			"is_dashboard_overlay" : true,
			"image_path" : "resources/icon.png",
			"action_manifest_path" : "resources/overlay/actions.json",
			"strings" : {
				"en_us" : {
					"name" : "Recline VR",
					"description" : "Recenter pitch, roll and yaw so you can use VR lying down"
				}
			}
		}
	]
}
